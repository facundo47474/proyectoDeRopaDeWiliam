# ============================================================
# VARIABLES DE ENTORNO — UrbanHustler Serverless Functions
# ============================================================
#
# ⚠️  IMPORTANTE: Este archivo NO se sube a Git (ya está en .gitignore).
# Las variables de entorno reales se configuran en el dashboard de Vercel:
# https://vercel.com/[tu-usuario]/urbanhustler/settings/environment-variables
#
# ============================================================

# --- URL PÚBLICA DEL SITIO ---
PUBLIC_SITE_URL=https://urbanhustler.vercel.app

# --- MERCADO PAGO (Checkout Pro + Webhooks) ---
# Token privado del vendedor (APP_USR-xxxx en producción o TEST-xxxx en sandbox)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-00000000
# Public Key de la aplicación Mercado Pago
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Clave secreta del Webhook (desde Mercado Pago Developers -> Tus integraciones -> Webhooks)
MP_WEBHOOK_SECRET=tu_clave_secreta_webhook_mp

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=543305563101-jdvoskcnplk9tguiqbgt2g68snd7mlk0.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_secreto_aqui

# --- FIREBASE ADMIN (Escritura segura desde Vercel Serverless y Webhooks) ---
# ID del proyecto Firebase (siempre igual)
FIREBASE_PROJECT_ID=urbanhustler-15d31

# Email de la cuenta de servicio (viene del JSON descargado de Firebase -> Cuentas de servicio)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@urbanhustler-15d31.iam.gserviceaccount.com

# Clave privada (viene del JSON, IMPORTANTE: conservar \n o saltos de línea reales en Vercel)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...(tu clave aquí)...\n-----END PRIVATE KEY-----\n"
