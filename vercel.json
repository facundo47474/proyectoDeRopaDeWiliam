{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/producto/:slug",
      "destination": "/api/producto?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin",
      "destination": "/HTML/controlCenter.html"
    },
    {
      "source": "/historial",
      "destination": "/HTML/salesHistory.html"
    },
    {
      "source": "/categoria/:cat",
      "destination": "/HTML/index.html?category=:cat"
    },
    {
      "source": "/",
      "destination": "/HTML/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(?:jpg|jpeg|png|webp|mp4|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(?:js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}