{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/producto/:slug",
      "destination": "/api/producto?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin",
      "destination": "/HTML/controlCenter.html"
    },
    {
      "source": "/historial",
      "destination": "/HTML/salesHistory.html"
    },
    {
      "source": "/categoria/:cat",
      "destination": "/HTML/index.html?category=:cat"
    },
    {
      "source": "/",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/HTML/index.html"
    }
  ]
}
