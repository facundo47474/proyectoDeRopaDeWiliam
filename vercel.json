{
  "rewrites": [
    { "source": "/producto/:slug", "destination": "/api/producto?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/admin", "destination": "/admin/panel.html" },
    { "source": "/historial", "destination": "/admin/ventas.html" },
    { "source": "/categoria/:cat", "destination": "/index.html?category=:cat" }
  ],
  "headers": [
    {
      "source": "/recursos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/estilos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}

